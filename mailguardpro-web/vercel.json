{
  "crons": [
    {
      "path": "/api/cron/sync-disposable",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/reset-credits",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/check-credits",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/process-deletions",
      "schedule": "*/5 * * * *"
    }
  ]
}
