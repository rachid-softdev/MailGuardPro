# ============================================================
# MailGuard Pro prospecting — configuration VPS
# Copier vers .env puis adapter. Ne jamais committer .env.
# ============================================================

# ------------------------------------------------------------
# IA du VPS
# ------------------------------------------------------------
# opencode  : CLI opencode installé et authentifié sur le VPS
# openai    : API compatible OpenAI (Ollama, vLLM, LM Studio...)
# openrouter: API OpenRouter (clé requise)
# heuristic : aucun LLM, scoring/rédaction locales (secours)
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_HEURISTIC=true

# Variante opencode :
# LLM_PROVIDER=opencode
# OPENCODE_MODEL=opencode/big-pickle
# OPENCODE_BIN=opencode

# Variante OpenRouter :
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# Variante sans IA (dépannage / VPS sans LLM) :
# LLM_PROVIDER=heuristic

# ------------------------------------------------------------
# Envoi
# ------------------------------------------------------------
# Sécurité : true tant que les brouillons n'ont pas été relus.
DRY_RUN=true
RESEND_API_KEY=
SENDER_EMAIL="prospection@mailguard.pro"
SENDER_NAME="MailGuard Pro"
SENDER_SIGNATURE="L'équipe MailGuard Pro"
UNSUBSCRIBE_EMAIL="unsubscribe@mailguard.pro"

DAILY_SEND_LIMIT=20
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
MAX_EMAILS_PER_COMPANY=2

# ------------------------------------------------------------
# Run quotidien
# ------------------------------------------------------------
DISCOVERY_LIMIT=100
QUALIFY_LIMIT=150
ENRICH_LIMIT=50
VERIFY_LIMIT=100
VERIFY_WORKERS=8
PERSONALIZE_LIMIT=30
FOLLOWUP_LIMIT=20
EXPORT_MIN_SCORE=70

# Découverte par annuaires (fiable depuis un VPS)
SCALE_LIMIT=100
SCALE_WORKERS=4

# Google/DDG depuis un VPS : souvent bloqué par les IP datacenter.
# Laisser false et utiliser les annuaires. Passer à true pour tester.
ENABLE_WEB_DISCOVERY=false

# ------------------------------------------------------------
# Divers
# ------------------------------------------------------------
DISCORD_WEBHOOK_URL=
RUNNER_HOST=vps
LOG_DIR=data/logs
