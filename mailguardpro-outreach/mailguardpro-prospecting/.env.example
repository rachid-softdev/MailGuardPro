# ==========================================
# Agent de prospection MailGuard Pro - Variables
# ==========================================

# ---------------------------------------------------------------
# LLM
# ---------------------------------------------------------------
# Backend : opencode | openrouter | openai | heuristic
# - opencode  : CLI local `opencode` (installé + authentifié, aucune clé API)
# - openrouter: API REST OpenRouter (OPENROUTER_API_KEY requise)
# - openai    : API compatible OpenAI (Ollama, vLLM, LM Studio...)
# - heuristic : aucun LLM, scoring et rédaction locales (mode de secours)
LLM_PROVIDER=opencode
OPENCODE_MODEL=opencode/big-pickle
# OPENCODE_BIN=opencode

# Si LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini

# Si LLM_PROVIDER=openai (ex. Ollama local sur le VPS)
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Si l'appel LLM échoue (quota, panne, modèle absent), basculer sur
# l'heuristique locale au lieu de perdre le prospect.
LLM_FALLBACK_HEURISTIC=true

# ---------------------------------------------------------------
# Envoi d'emails (Resend REST API)
# ---------------------------------------------------------------
# Laissez vide pour ce premier lot : DRY_RUN=true empêche tout envoi.
RESEND_API_KEY=
SENDER_EMAIL=prospection@mailguard.pro
SENDER_NAME="MailGuard Pro"
SENDER_SIGNATURE="L'équipe MailGuard Pro"
UNSUBSCRIBE_EMAIL=unsubscribe@mailguard.pro

# Mode sec : rien n'est envoyé tant que DRY_RUN n'est pas false
DRY_RUN=true

# Limites d'envoi (anti-spam)
DAILY_SEND_LIMIT=20
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
MAX_EMAILS_PER_COMPANY=2

# ---------------------------------------------------------------
# Limites du run quotidien (utilisées par deploy/run_daily.sh)
# ---------------------------------------------------------------
DISCOVERY_LIMIT=100
QUALIFY_LIMIT=150
ENRICH_LIMIT=50
VERIFY_LIMIT=100
VERIFY_WORKERS=8
PERSONALIZE_LIMIT=30
FOLLOWUP_LIMIT=20
EXPORT_MIN_SCORE=70

# Découverte par annuaires (run_scale.py)
SCALE_LIMIT=100
SCALE_WORKERS=4

# Webhook Discord (optionnel) - résumé du run
DISCORD_WEBHOOK_URL=

# Identification du runner (local, github, vps)
RUNNER_HOST=local
